# --- LLM endpoint (LM Studio local server, OpenAI-compatible) ---
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio
AI_MODEL_NAME=qwen2.5-coder-32b-instruct-abliterated

# --- Generation ---
# Max tokens generated per request. Raise it if long files get cut off.
# The model's context length in LM Studio must be larger than prompt + this value.
AI_MAX_TOKENS=16384
# 0.1-0.3 works best for code with Qwen coder models.
AI_TEMPERATURE=0.2
# If a reply hits the token limit the agent asks the model to continue, up to this many times.
AI_MAX_CONTINUATIONS=6
AI_TIMEOUT_MS=600000
# Set to 0 to hide the live "generating… N chars" line.
AI_STREAM_PROGRESS=1

# --- Model behavior (normally decided automatically from the model id, see src/llm/models.ts) ---
# on/off forces native tool calling. Codestral, Phi-4, DeepSeek-Coder and R1 default to off
# (the agent then uses fenced action blocks and sends no `tools` payload).
# AI_NATIVE_TOOLS=off
# Adds /no_think for Qwen3 hybrid models so they do not spend tokens thinking.
# AI_NO_THINK=on
# Set to 0 to hide the per-call "first token / tok/s" line.
AI_STATS=1

# --- Caching ---
# Set to off to bypass the LLM response cache (.agent_cache/).
AI_CACHE=on
# Cache entries older than this many days, or beyond this total size, are deleted at startup.
# AI_CACHE_TTL_DAYS=7
# AI_CACHE_MAX_MB=300

# --- Agent loop ---
AGENT_MAX_STEPS=50
# Task routing: auto = keyword match first, then ask the model (output capped at 24 tokens);
# keywords = never ask the model, unmatched tasks go to the dev agent.
# AGENT_ROUTER=auto
# The debug agent runs a strict allowlist of read-only commands (git status, node -v, lsof -i :PORT ...)
# without asking. 0 = ask for every command, as for the other agents.
# AGENT_AUTO_DIAG=1
# Auto mode (chat startup prompt, -y, AGENT_AUTO_WRITE=1) writes files AND runs commands without asking,
# except risky ones (rm, sudo, git reset/push, kill ...). 0 = commands always ask, even in auto mode.
# AGENT_AUTO_RUN=1
# Longest a build/test/install command (gradlew, xcodebuild, npm run build ...) may run, in minutes. Ctrl+C stops any command at any time.
# AGENT_CMD_TIMEOUT_MIN=30
# Automatic debugging (1 = a failed command starts the Debug Agent; needs auto-write and auto-run; also --auto-debug, /auto-debug).
# AGENT_AUTO_DEBUG=0
# Debug attempts on the SAME command before the run stops with a "Project Failure & Triage Report" (1-10).
# AGENT_AUTO_DEBUG_ATTEMPTS=5
# Debug runs per session in total (1-30), and steps per debug run (3-200).
# AGENT_AUTO_DEBUG_MAX=10
# AGENT_AUTO_DEBUG_STEPS=25
# Parallel team: model calls at once (1-16) and steps per parallel task (3-500).
# AGENT_LLM_CONCURRENCY=2
# AGENT_TASK_MAX_STEPS=60
# Vision model for `/image <path>` (a picture of what you want). Load a vision model in LM Studio and put its id here;
# the picture then never leaves your machine. Without it, Gemini can read the image after you confirm (sent to Google).
# AI_VISION_MODEL=
# Older tool output is elided once the conversation exceeds this many characters.
AGENT_CONTEXT_CHARS=60000
# Character budget of knowledge files injected into each agent's system prompt.
AGENT_SKILL_CHARS=9000
# Extra standards chosen from the task text (edge cases, decomposition, security, database ...): max files and character budget.
# AGENT_TASK_FILES=5
# AGENT_TASK_CHARS=8000
# The target project's own AGENTS.md / CLAUDE.md (workspace root) are added to the prompt, up to this many characters.
# AGENT_PROJECT_CHARS=3500

# --- Gemini research stage + planner (OPTIONAL, the only feature that sends data off your machine) ---
# Put the key in `.env` (git-ignored), NOT in .env.local or the profile files (those are committed).
# GEMINI_API_KEY=
# Flow: the RESEARCH agent runs first (Gemini + Google Search grounding: understands the request, searches, returns a brief);
# the PLANNER (Gemini) runs after it only when the research says a plan is needed.
# on = every task goes through the research stage first (also asked at chat startup when a key exists); off = never.
# What is sent: the question and a file-name overview of the project (no file contents), secrets masked.
# AGENT_RESEARCH=on
# auto (default) = plan only when needed; always = plan after every research; off = never plan.
# AGENT_PLANNER=auto
# Off by default: the research stage only analyses the request. 1 = it also searches Google through Gemini grounding,
# which uses up the small free quota quickly (HTTP 429). The local agent's own web_search is not affected by this.
# AGENT_RESEARCH_GROUNDING=0
# AGENT_RESEARCH_TIMEOUT_MS=60000
# Max characters of the research brief handed to the local model.
# AGENT_RESEARCH_MAX_CHARS=2800
# 1 = ask before the brief/plan is given to the local agent.
# AGENT_RESEARCH_CONFIRM=1
# (AGENT_TRIAGE=on is still read as an older name of AGENT_RESEARCH=on.)
# Model order is tried left to right; run `npm run triage:models` to see what your key can use.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash
# AGENT_TRIAGE_TIMEOUT_MS=60000
# Max characters of the plan handed to the local model.
# AGENT_TRIAGE_MAX_CHARS=4500

# --- Web access (web_search / web_fetch / web_research tools, used mainly by the research agent) ---
# Web search is LOCAL ONLY: every query goes to your own SearXNG (docker compose up -d in ../searxng, json format enabled).
# No cloud search API is used. The tool covers technical documentation AND general real-time information (news, weather, facts);
# the category (general / it / news / science) is chosen from the query, and an empty narrow category falls back to general.
# SEARXNG_URL=http://localhost:8080
# SearXNG uses the engines enabled in its own settings. Results that several engines agree on rank higher, questions about code
# also ask its IT category (GitHub, Stack Overflow, MDN), and `npm run search:test` lists which engines answered or failed.
# Optional: force a list of engines (they must be enabled in SearXNG's settings.yml) or a language.
# SEARXNG_ENGINES=bing,startpage,mojeek
# SEARXNG_LANGUAGE=en
# WEB_SEARCH_ENGINES is ignored: search always uses SearXNG only. Diagnose it with:
#   npm run search:verify            checks that SearXNG answers clean JSON for code, error, general, news and weather queries
#   npm run search:test -- "query"   runs one search and shows which engines answered
# Per-request limit for SearXNG in ms (a slow upstream engine can hold a search back).
# SEARXNG_TIMEOUT_MS=15000
# Gemini's Google Search quota only matters for the optional research stage (AGENT_RESEARCH_GROUNDING=1): when it is used up
# (HTTP 429) that stage runs without search for this many ms (default 300000 = 5 min).
# AGENT_GROUNDING_BLOCK_MS=300000
# WEB_TIMEOUT_MS=12000
# WEB_MAX_PAGE_BYTES=2500000
# PDFs (web_fetch / web_research read the text layer with the `unpdf` package; scanned PDFs have no text and are not OCR'd).
# WEB_MAX_PDF_BYTES=15000000
# WEB_PDF_MAX_PAGES=80

# --- MCP ---
# Defaults to ./mcp.config.json (sequential-thinking server). Use --no-mcp to skip.
# AGENT_MCP_CONFIG=/absolute/path/to/mcp.config.json

# --- Remote access over Tailscale (docs/REMOTE.md) ---
# `npm run chat:ui:remote` sets AGENT_UI_REMOTE=1. The agent still binds to 127.0.0.1; Tailscale Serve (`npm run remote:on`)
# publishes the dashboard to YOUR tailnet only. Put the token in `.env` (git-ignored), never in a committed profile file.
# A long random token (openssl rand -hex 24) keeps your phone bookmark working between restarts.
# AGENT_UI_TOKEN=
# Host name of this machine on your tailnet. Auto-detected from the Tailscale CLI when unset.
# AGENT_UI_REMOTE_HOST=my-mac.tail1234.ts.net
