# Devstral Small (24B dense, trained for agentic coding with tool calls). ~14 GB at Q4.
# Slower than the MoE option (dense: every weight is read for every token), so the context
# budget is trimmed. The exact id depends on your download: run `npm run models`.
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio
AI_MODEL_NAME=mistralai/devstral-small-2507
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2
AGENT_CONTEXT_CHARS=44000
AGENT_SKILL_CHARS=7000
