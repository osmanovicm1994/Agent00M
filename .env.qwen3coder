# Recommended daily driver: Qwen3-Coder-30B-A3B (mixture-of-experts, ~3B active parameters).
# Native tool calling, fast on Apple Silicon, ~18 GB at Q4.
# The exact id depends on your LM Studio download: run `npm run models` and copy it here.
#
# IMPORTANT: load the model in LM Studio with Context Length 32768 (16384 minimum).
# LM Studio's default is 4096-8192, and the agent's system prompt + knowledge + history
# is already ~10k tokens. The context length is set in LM Studio, not here.
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio
AI_MODEL_NAME=qwen/qwen3-coder-30b
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2
# Sized for a 32k-token window. With only a 16k window use 30000 / 6000 instead.
AGENT_CONTEXT_CHARS=60000
AGENT_SKILL_CHARS=9000
