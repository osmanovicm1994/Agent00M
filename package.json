{
  "name": "agent-cli",
  "version": "0.1.0",
  "description": "Copilot-CLI-style local coding agent, backed by DeepSeek R1 via LM Studio (pluggable LLM backends).",
  "private": true,
  "type": "commonjs",
  "bin": {
    "agent": "./dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "chat": "dotenv -e .env.local -- ts-node src/cli.ts chat",
    "chat:local": "dotenv -e .env.local -- ts-node src/cli.ts chat",
    "chat:nim": "dotenv -e .env.nim -- ts-node src/cli.ts chat"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "openai": "^4.68.0",
    "picocolors": "^1.0.1",
    "prompts": "^2.4.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.9",
    "@types/prompts": "^2.4.9",
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
