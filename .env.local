AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio
AI_MODEL_NAME=qwen/qwen3-coder-30b
AI_MAX_TOKENS=16384
AI_TEMPERATURE=0.3
# Sized for a 32k-token window. With only a 16k window use 30000 / 6000 instead.
AGENT_CONTEXT_CHARS=60000
AGENT_SKILL_CHARS=19000
# Web search is local only: every query goes to your own SearXNG (../searxng, `docker compose up -d`). No cloud search API.
SEARXNG_URL=http://localhost:8080
# Team mode: show the Project Manager's task split and wait for your answer (y = start, e = save the task files and stop so you can edit them, n = cancel). Works in auto mode and from the dashboard. 0 = start without asking.
AGENT_PLAN_REVIEW=1
# One model call at a time. LM Studio on one GPU answers one request at a time: with 2 in flight each 28k-token prompt takes twice as long to process and one hit the 600 s limit in a real run. Tasks still overlap their shell time (installs, builds, tests).
AGENT_LLM_CONCURRENCY=1
# Language of everything you read: auto (default, detects Bosnian in your request), bs, or en. Code, commands and task criteria always stay English.
# AGENT_LANGUAGE=auto
