# Codestral 22B (dense). It has NO tool-calling chat template, so the agent automatically
# uses fenced action blocks for it (no `tools` payload is sent). ~16 GB at Q5_K_M.
# Dense + long prompts = slow prompt processing, so the context budget is trimmed.
# The exact id depends on your download: run `npm run models`.
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio
AI_MODEL_NAME=mistralai/codestral-22b-v0.1
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2
AGENT_CONTEXT_CHARS=36000
AGENT_SKILL_CHARS=6000
